\@writefile{toc}{\contentsline {paragraph}{实验一：单向模式与双马达模式的对比}{13}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 单/双马达驱动下各关节角度对比。蓝色为仅 Motor A（$\theta _A=3$\,rad），橙色为仅 Motor B（$\theta _B=3$\,rad），绿色为双马达同向驱动（$\theta _A=\theta _B=3$\,rad），红色虚线为两个单向结果的简单算术平均。双驱动结果介于两者之间且不与简单平均重合，体现了 Schur 补公式产生的交叉耦合效应。}}{13}{figure.caption.22}\protected@file@percent }
\newlabel{fig:single_vs_dual}{{5}{13}{单/双马达驱动下各关节角度对比。蓝色为仅 Motor A（$\theta _A=3$\,rad），橙色为仅 Motor B（$\theta _B=3$\,rad），绿色为双马达同向驱动（$\theta _A=\theta _B=3$\,rad），红色虚线为两个单向结果的简单算术平均。双驱动结果介于两者之间且不与简单平均重合，体现了 Schur 补公式产生的交叉耦合效应。}{figure.caption.22}{}}
\@writefile{toc}{\contentsline {paragraph}{实验二：SDAS 模型与 Augmented Adaptive Synergy 模型的对比}{13}{section*.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 相同输入下 SDAS 模型与 Augmented Adaptive Synergy 模型的关节角度对比。$\sigma = 5$\,rad，$\sigma _f = 2$\,rad。SDAS 模型通过 $\mathbf  {R}_A/\mathbf  {R}_B$ 的自然非对称性直接产生不对称的关节角分布，完全无需 $\mathbf  {R}_f$ 矩阵及其可调参数。}}{14}{figure.caption.23}\protected@file@percent }
\newlabel{fig:sdas_vs_augmented}{{6}{14}{相同输入下 SDAS 模型与 Augmented Adaptive Synergy 模型的关节角度对比。$\sigma = 5$\,rad，$\sigma _f = 2$\,rad。SDAS 模型通过 $\mathbf {R}_A/\mathbf {R}_B$ 的自然非对称性直接产生不对称的关节角分布，完全无需 $\mathbf {R}_f$ 矩阵及其可调参数。}{figure.caption.23}{}}
\@writefile{toc}{\contentsline {paragraph}{实验三：动力学数值仿真验证}{14}{section*.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 三段 $\sigma _f$ 输入下两个代表性关节（关节 0 和关节 7）的角度时间历程。$\sigma _f$ 在 $t=0.3$\,s 和 $t=0.6$\,s 处发生阶跃切换，关节角度曲线连续光滑过渡，无振荡或跳变。蓝色实线对应 Joint 0（靠近 Motor A），橙色实线对应 Joint 7（靠近 Motor B）。}}{15}{figure.caption.26}\protected@file@percent }
\newlabel{fig:three_phase}{{7}{15}{三段 $\sigma _f$ 输入下两个代表性关节（关节 0 和关节 7）的角度时间历程。$\sigma _f$ 在 $t=0.3$\,s 和 $t=0.6$\,s 处发生阶跃切换，关节角度曲线连续光滑过渡，无振荡或跳变。蓝色实线对应 Joint 0（靠近 Motor A），橙色实线对应 Joint 7（靠近 Motor B）。}{figure.caption.26}{}}
