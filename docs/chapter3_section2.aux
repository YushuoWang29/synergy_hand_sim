\@writefile{toc}{\contentsline {paragraph}{实验 A：单马达与双马达模式对比}{8}{section*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 单马达与双马达模式下各关节角度对比（$\theta _A,\theta _B$ 单位：rad）。蓝色为仅 Motor A，橙色为仅 Motor B，绿色为双马达同向驱动，红色虚线为两个单向结果的简单算术平均。双驱动结果介于两者之间且不与简单平均重合，体现了 Schur 补交叉耦合效应。}}{9}{figure.caption.16}\protected@file@percent }
\newlabel{fig:single_vs_dual}{{1}{9}{单马达与双马达模式下各关节角度对比（$\theta _A,\theta _B$ 单位：rad）。蓝色为仅 Motor A，橙色为仅 Motor B，绿色为双马达同向驱动，红色虚线为两个单向结果的简单算术平均。双驱动结果介于两者之间且不与简单平均重合，体现了 Schur 补交叉耦合效应。}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {paragraph}{实验 B：SDAS 与经典自适应协同模型对比}{9}{section*.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces SDAS 模型与经典自适应协同模型的 $\sigma _f$ 响应对比。横坐标为 $\sigma _f$（单位：rad），纵坐标为关节角度（单位：rad）。左图为关节 1 响应，右图为关节 2 响应。SDAS 模型（实线）通过 $\mathbf  {R}_A \neq  \mathbf  {R}_B$ 自然产生非对称响应，无需显式 $\mathbf  {R}_f$ 矩阵。}}{9}{figure.caption.18}\protected@file@percent }
\newlabel{fig:sdas_vs_classic}{{2}{9}{SDAS 模型与经典自适应协同模型的 $\sigma _f$ 响应对比。横坐标为 $\sigma _f$（单位：rad），纵坐标为关节角度（单位：rad）。左图为关节 1 响应，右图为关节 2 响应。SDAS 模型（实线）通过 $\mathbf {R}_A \neq \mathbf {R}_B$ 自然产生非对称响应，无需显式 $\mathbf {R}_f$ 矩阵。}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {paragraph}{动力学数值仿真验证}{10}{section*.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 三段 $\sigma _f$ 输入下关节角度的动力学仿真时间历程。$\sigma _f$ 在 $t=0.3$\,s 和 $t=0.6$\,s 处阶跃切换。蓝色实线为关节 1（靠近 Motor A），橙色实线为关节 3（靠近 Motor B）。关节角度连续光滑过渡，无振荡或跳变。}}{10}{figure.caption.20}\protected@file@percent }
\newlabel{fig:three_phase}{{3}{10}{三段 $\sigma _f$ 输入下关节角度的动力学仿真时间历程。$\sigma _f$ 在 $t=0.3$\,s 和 $t=0.6$\,s 处阶跃切换。蓝色实线为关节 1（靠近 Motor A），橙色实线为关节 3（靠近 Motor B）。关节角度连续光滑过渡，无振荡或跳变。}{figure.caption.20}{}}
